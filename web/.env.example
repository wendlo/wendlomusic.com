# ---------------------------------------------------------------------------
# Wendlo — environment variables
#
# Copy to `.env.local` and fill in. With NO env configured the site builds +
# renders from baked fallback content and every integration degrades
# gracefully, so every var below is OPTIONAL for a local dev build.
# ---------------------------------------------------------------------------

# --- Sanity CMS (Phase 1) --------------------------------------------------
# When NEXT_PUBLIC_SANITY_PROJECT_ID is set, the content resolver switches from
# baked fallback content to a live GROQ fetch, and /studio mounts the Studio.
# Leave it UNSET to keep the fully-static baked build.
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset name. Defaults to "production" when unset.
NEXT_PUBLIC_SANITY_DATASET=production
# Pinned GROQ/Studio API version (YYYY-MM-DD). Defaults to 2024-10-01.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only read token. Needed for a PRIVATE dataset AND for live preview
# (draft mode / the Studio Presentation tool): /api/draft-mode/enable responds
# 503 without it. Never expose to the browser.
SANITY_API_READ_TOKEN=
# Server-only WRITE token — used ONLY by scripts/seed.ts (npx tsx scripts/seed.ts)
# to upsert content + upload assets. Never ship this to the client or CI build.
SANITY_API_WRITE_TOKEN=

# --- Sanity revalidation webhook (Phase 5) ----------------------------------
# Shared secret for the Sanity → /api/revalidate webhook (HMAC-verified via
# next-sanity/webhook). Configure the same value on the webhook in
# sanity.io/manage. Unset → /api/revalidate responds 503 and published content
# stays cached until redeploy.
SANITY_REVALIDATE_SECRET=

# --- Shopify storefront (public; code defaults exist) -----------------------
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# NEXT_PUBLIC_SHOPIFY_API_VERSION — REMOVED / IGNORED. The Storefront API
# version is pinned in code (SHOPIFY_STOREFRONT_API_VERSION in
# src/lib/shopify.ts, currently 2026-10) because it is coupled to the queries.
# Setting this var has no effect; delete any stale value from Vercel.

# --- Bandsintown (public; code defaults exist) -------------------------------
NEXT_PUBLIC_BANDSINTOWN_ARTIST_ID=
NEXT_PUBLIC_BANDSINTOWN_APP_ID=

# --- Form submit pipeline (/api/submit, Phase 4) -----------------------------
# Upstash-compatible Redis REST endpoint — rate limiting, idempotency, and
# Turnstile token single-use. Unset → all three checks no-op (allow).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cloudflare Turnstile. Public site key renders the widget client-side (unset →
# no widget, no script load); secret key verifies tokens server-side (unset →
# siteverify skipped entirely, tokenless submits accepted).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Sheets record-of-truth. ALL THREE required or the Sheets step is
# skipped. The private key may keep its \n-escaped form from the service
# account JSON — it is un-escaped at point of use.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Mailchimp list signup (email kind only). ALL THREE required or skipped.
# Server prefix is the "usXX" in your API endpoint.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Resend notification email (best-effort; never fails a submission). ALL THREE
# required or skipped.
EMAIL_PROVIDER_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# --- Smart-link import proxy (/api/proxy, Phase 4) ---------------------------
# Comma-separated host allowlist (subdomains match). Code default:
# distrokid.com,hyperfollow.com,tunecore.com,ffm.to,lnk.to
# Widen it (e.g. with a cover-art CDN host) WITHOUT redeploying code.
PROXY_ALLOWED_HOSTS=

# --- Misc --------------------------------------------------------------------
# Canonical site origin for metadata. Defaults to https://www.wendlomusic.com.
NEXT_PUBLIC_SITE_URL=
